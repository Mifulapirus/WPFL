# WPFL Match Tracker configuration. Copy to .env and fill in.
# Referee password (≥ 6 chars). Shared by all referees.
REFEREE_PASSWORD=
# Shared key the arena LED driver uses to connect (≥ 16 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Leave empty to disable the LED link.
LED_KEY=
# Listen address. Keep 127.0.0.1 behind nginx.
HOST=127.0.0.1
PORT=3110
# Behind nginx: trust X-Forwarded-For for login rate limiting.
TRUST_PROXY=1
# Where event.json lives (relative to this folder or absolute).
DATA_DIR=data
# Optional: session signing secret (auto-generated into DATA_DIR if empty). Change it to sign everyone out.
SESSION_SECRET=
# Referee session length in hours.
SESSION_HOURS=14
